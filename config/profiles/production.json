{
  "profile_name": "production",
  "description": "Production environment with full redundancy and strict settings",
  "environment": "production",
  
  "data_providers": {
    "binance": {
      "enabled": true,
      "use_testnet": false,
      "rate_limits": {
        "requests_per_second": 10,
        "requests_per_minute": 1200
      }
    },
    "coinbase": {
      "enabled": true
    },
    "kraken": {
      "enabled": true
    },
    "alpha_vantage": {
      "enabled": true
    },
    "yahoo_finance": {
      "enabled": true
    },
    "metatrader": {
      "enabled": true
    }
  },
  
  "data_aggregation": {
    "method": "weighted_average",
    "min_sources": 3,
    "max_sources": 5,
    "enable_quality_scoring": true,
    "enable_outlier_detection": true,
    "outlier_threshold": 3.0,
    "staleness_penalty_minutes": 5.0,
    "enable_cross_validation": true
  },
  
  "data_manager": {
    "historical_days": 365,
    "cache_ttl_minutes": 5,
    "cache_size_mb": 2048,
    "update_interval_ms": 1000,
    "enable_data_validation": true,
    "enable_persistence": true
  },
  
  "monitoring": {
    "health_check_interval_seconds": 30,
    "alert_thresholds": {
      "latency_ms": 1000,
      "error_rate_percent": 5.0,
      "data_gap_minutes": 15
    },
    "enable_slack_alerts": true,
    "enable_email_alerts": true,
    "enable_prometheus_metrics": true
  },
  
  "trading": {
    "paper_trading": false,
    "max_position_size": 10000,
    "enable_risk_management": true,
    "simulation_mode": false,
    "enable_circuit_breakers": true,
    "max_daily_loss": 5000,
    "var_confidence": 0.95
  },
  
  "logging": {
    "level": "info",
    "enable_file_logging": true,
    "enable_console_logging": false,
    "log_directory": "logs/prod/",
    "max_log_file_size_mb": 500,
    "enable_log_rotation": true,
    "enable_structured_logging": true
  },
  
  "performance": {
    "enable_profiling": false,
    "enable_metrics_collection": true,
    "metrics_export_interval_seconds": 60,
    "enable_performance_alerts": true
  },
  
  "security": {
    "enable_api_key_rotation": true,
    "enable_rate_limiting": true,
    "enable_request_validation": true,
    "enable_encryption": true,
    "session_timeout_minutes": 30
  },
  
  "features": {
    "enable_test_data": false,
    "enable_mock_providers": false,
    "enable_data_simulation": false,
    "enable_backtesting": true,
    "enable_portfolio_optimization": true,
    "enable_automated_trading": true,
    "enable_risk_monitoring": true
  },
  
  "backup": {
    "enable_data_backup": true,
    "backup_interval_hours": 6,
    "backup_retention_days": 30,
    "backup_location": "backups/",
    "enable_cloud_backup": true
  }
}
