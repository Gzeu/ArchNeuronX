{
  "profile_name": "high_frequency",
  "description": "High-frequency trading profile with minimal latency and maximum throughput",
  "environment": "production",
  
  "data_providers": {
    "binance": {
      "enabled": true,
      "use_testnet": false,
      "rate_limits": {
        "requests_per_second": 20,
        "requests_per_minute": 2400
      },
      "connection_timeout_ms": 5000,
      "read_timeout_ms": 3000
    },
    "kraken": {
      "enabled": true,
      "rate_limits": {
        "requests_per_second": 20,
        "requests_per_minute": 1800
      }
    },
    "metatrader": {
      "enabled": true,
      "rate_limits": {
        "requests_per_second": 15,
        "requests_per_minute": 1500
      }
    }
  },
  
  "data_aggregation": {
    "method": "latest_timestamp",
    "min_sources": 2,
    "max_sources": 3,
    "enable_quality_scoring": true,
    "enable_outlier_detection": false,
    "staleness_penalty_minutes": 1.0,
    "enable_cross_validation": true,
    "source_weights": {
      "binance": 0.4,
      "kraken": 0.35,
      "metatrader": 0.25
    }
  },
  
  "data_manager": {
    "historical_days": 7,
    "cache_ttl_minutes": 1,
    "cache_size_mb": 4096,
    "update_interval_ms": 100,
    "enable_data_validation": false,
    "enable_persistence": true,
    "max_concurrent_requests": 50
  },
  
  "monitoring": {
    "health_check_interval_seconds": 10,
    "alert_thresholds": {
      "latency_ms": 100,
      "error_rate_percent": 1.0,
      "data_gap_minutes": 5
    },
    "enable_real_time_alerts": true,
    "enable_performance_monitoring": true
  },
  
  "trading": {
    "paper_trading": false,
    "max_position_size": 50000,
    "enable_risk_management": true,
    "simulation_mode": false,
    "enable_circuit_breakers": true,
    "max_daily_loss": 10000,
    "var_confidence": 0.99,
    "enable_scalping": true,
    "enable_market_making": false,
    "position_sizing_method": "fixed_fraction",
    "max_positions_per_symbol": 1
  },
  
  "logging": {
    "level": "warn",
    "enable_file_logging": true,
    "enable_console_logging": false,
    "log_directory": "logs/hft/",
    "max_log_file_size_mb": 1000,
    "enable_log_rotation": true,
    "enable_structured_logging": true,
    "enable_performance_logging": true
  },
  
  "performance": {
    "enable_profiling": true,
    "enable_metrics_collection": true,
    "metrics_export_interval_seconds": 10,
    "enable_latency_tracking": true,
    "enable_throughput_monitoring": true
  },
  
  "optimization": {
    "enable_memory_pool": true,
    "enable_zero_copy": true,
    "enable_async_processing": true,
    "enable_batch_processing": true,
    "max_batch_size": 1000,
    "enable_lock_free_structures": true
  },
  
  "features": {
    "enable_test_data": false,
    "enable_mock_providers": false,
    "enable_data_simulation": false,
    "enable_backtesting": false,
    "enable_portfolio_optimization": false,
    "enable_automated_trading": true,
    "enable_risk_monitoring": true,
    "enable_market_microstructure_analysis": true,
    "enable_order_flow_analysis": true
  },
  
  "network": {
    "enable_connection_pooling": true,
    "max_connections_per_provider": 10,
    "connection_timeout_ms": 1000,
    "read_timeout_ms": 500,
    "keep_alive_interval_seconds": 30,
    "enable_compression": true,
    "enable_tcp_nodelay": true
  },
  
  "backup": {
    "enable_data_backup": true,
    "backup_interval_hours": 1,
    "backup_retention_days": 7,
    "backup_location": "backups/hft/",
    "enable_incremental_backup": true
  }
}
